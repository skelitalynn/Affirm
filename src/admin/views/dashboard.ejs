<div class="dashboard">
    <div class="stats">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3>Profiles</h3>
                <p class="stat-number"><%= stats.profilesCount || 0 %></p>
                <p class="stat-desc">已配置的长期记忆记录</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-brain"></i>
            </div>
            <div class="stat-content">
                <h3>知识条目</h3>
                <p class="stat-number"><%= stats.knowledgeCount || 0 %></p>
                <p class="stat-desc">本地桥接层中的知识片段</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-comments"></i>
            </div>
            <div class="stat-content">
                <h3>对话消息</h3>
                <p class="stat-number"><%= stats.messagesCount || 0 %></p>
                <p class="stat-desc">已处理的用户与助手消息</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-bookmark"></i>
            </div>
            <div class="stat-content">
                <h3>Memory Events</h3>
                <p class="stat-number"><%= stats.memoryEventsCount || 0 %></p>
                <p class="stat-desc">可治理的历史事件记忆</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-link"></i>
            </div>
            <div class="stat-content">
                <h3>命中回复</h3>
                <p class="stat-number"><%= stats.memoryHitMessagesCount || 0 %></p>
                <p class="stat-desc">已记录 memory_refs 的 assistant 回复</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-arrows-rotate"></i>
            </div>
            <div class="stat-content">
                <h3>同步任务</h3>
                <p class="stat-number"><%= stats.syncJobsCount || 0 %></p>
                <p class="stat-desc">memory / knowledge 异步任务</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-list-check"></i>
            </div>
            <div class="stat-content">
                <h3>队列模式</h3>
                <p class="stat-number"><%= stats.queueMode || 'unknown' %></p>
                <p class="stat-desc">当前消息队列实现</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-wave-square"></i>
            </div>
            <div class="stat-content">
                <h3>Knowledge RAG</h3>
                <p class="stat-number"><%= stats.ragStatus || 'unknown' %></p>
                <p class="stat-desc">Haystack 检索链路状态</p>
            </div>
        </div>
    </div>

    <div class="recent-activity">
        <h3><i class="fas fa-server"></i> 系统概览</h3>
        <ul>
            <li>队列状态：<%= systemOverview?.queueStats?.mode || 'unknown' %>，processed=<%= systemOverview?.queueStats?.totalProcessed || 0 %>，failed=<%= systemOverview?.queueStats?.totalFailed || 0 %></li>
            <li>Haystack：<%= systemOverview?.ragStatus?.enabled ? 'enabled' : (systemOverview?.ragStatus?.configured ? 'degraded' : 'not configured') %></li>
            <li>同步任务：pending=<%= systemOverview?.syncJobSummary?.byStatus?.pending || 0 %>，processing=<%= systemOverview?.syncJobSummary?.byStatus?.processing || 0 %>，completed=<%= systemOverview?.syncJobSummary?.byStatus?.completed || 0 %>，failed=<%= systemOverview?.syncJobSummary?.byStatus?.failed || 0 %></li>
        </ul>
        <div class="action-bar">
            <a href="/admin/memory-events" class="btn btn-primary">
                <i class="fas fa-bookmark"></i> 查看 Memory Events
            </a>
            <a href="/admin/memory-events/hits" class="btn btn-secondary">
                <i class="fas fa-link"></i> 查看命中回复
            </a>
            <a href="/admin/sync-jobs" class="btn btn-secondary">
                <i class="fas fa-arrows-rotate"></i> 查看同步任务
            </a>
        </div>
    </div>

    <div class="recent-activity">
        <h3><i class="fas fa-history"></i> 最近活动</h3>
        <ul>
            <% if (recentActivity && recentActivity.length > 0) { %>
                <% recentActivity.forEach(activity => { %>
                    <li>
                        <span class="activity-time"><%= activity.time %></span>
                        <span class="activity-text"><%= activity.text %></span>
                    </li>
                <% }) %>
            <% } else { %>
                <li>暂无最近活动</li>
            <% } %>
        </ul>
    </div>
</div>
